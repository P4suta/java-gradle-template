<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter. Domain objects are often shared intentionally as an object graph,
  so the EI_EXPOSE_REP / EI_EXPOSE_REP2 mutable-reference warnings are excluded.
-->
<FindBugsFilter>
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
