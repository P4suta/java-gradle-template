# syntax=docker/dockerfile:1
# Dev/CI toolchain image: JDK 21 + Gradle + lint tools, pinned via the same mise.toml.
# Example: docker run --rm -v "$PWD":/work ghcr.io/p4suta/java-gradle-template:toolchain ./gradlew build

FROM debian:bookworm-slim

# Fail on errors in piped commands (hadolint DL4006).
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV MISE_DATA_DIR=/opt/mise \
    MISE_CONFIG_DIR=/opt/mise \
    MISE_CACHE_DIR=/opt/mise/cache \
    MISE_EXPERIMENTAL=1
ENV PATH=/opt/mise/shims:/usr/local/bin:$PATH
RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

WORKDIR /work

# Install tools first so this layer caches (only mise.toml invalidates it).
COPY mise.toml ./
RUN mise trust ./mise.toml \
    && mise install --yes \
    && mise reshim

CMD ["bash"]
