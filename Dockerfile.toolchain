# syntax=docker/dockerfile:1
# Local development image with the project's mise tools.
# Build: docker build -f Dockerfile.toolchain -t java-gradle-toolchain .

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

# Fail on errors in piped commands (hadolint DL4006).
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV MISE_DATA_DIR=/opt/mise \
    MISE_CONFIG_DIR=/opt/mise \
    MISE_CACHE_DIR=/opt/mise/cache \
    MISE_EXPERIMENTAL=1
ENV PATH=/opt/mise/shims:/usr/local/bin:$PATH
RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

WORKDIR /work

# Install tools first so this layer caches (only mise.toml invalidates it).
COPY mise.toml ./
RUN mise trust ./mise.toml \
    && mise install --yes \
    && mise reshim

CMD ["bash"]
