---
extends: default

rules:
  braces:
    max-spaces-inside: 1
  line-length:
    max: 140
    level: warning
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false
  document-start: enable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
